{
  "name": "cyberdeck-crt-terminal",
  "private": true,
  "version": "1.0.0",
  "description": "Cyberdeck CRT Terminal Emulator & Cross-Platform Shell",
  "author": "Cyberdeck <dev@cyberdeck.local>",
  "homepage": "https://github.com/cyberdeck/terminal",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server-terminal.js",
    "electron:start": "electron .",
    "package:win": "vite build && electron-builder --win",
    "package:linux": "vite build && electron-builder --linux",
    "package:mac": "vite build && electron-builder --mac",
    "package:all": "vite build && electron-builder -wlm",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.17.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.15",
    "@rolldown/binding-darwin-x64": "^1.2.15",
    "@rolldown/binding-linux-x64-gnu": "^1.2.15",
    "@rolldown/binding-win32-x64-msvc": "^1.2.15"
  },
  "build": {
    "appId": "com.cyberdeck.crtterminal",
    "productName": "Cyberdeck CRT Terminal",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server-terminal.js",
      "server-windows-terminal.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cyberdeck CRT Terminal",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "maintainer": "Cyberdeck <dev@cyberdeck.local>",
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "forceCodeSigning": false
    },
    "dmg": {
      "format": "UDZO",
      "sign": false
    }
  }
}
